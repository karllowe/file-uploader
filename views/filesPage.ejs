<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Files page</title>
    <link rel="stylesheet" href="/styles/styles.css">
</head>
<body>
    <h1>File uploader</h1>
    <div class="filesHeader">
        <h2>Welcome back <%= currentUser.name %></h2>
        <a href="/login/logout">
            <img src="/icons/logout.png" alt="">
        </a>
    </div>
    <div>
        <h3>Upload a file</h3>
        <form action="/upload/<%= folderId%>" method="post" enctype="multipart/form-data">
            <label for="file">Select file:</label>
            <input type="file" id="file" name="file">
            <button type="Submit">Upload</button>
        </form>
    </div>
    <div class="fileDiv">
        <div class="explorerHeader">
            <% if (folderInfo.parentId) {%>  
                <a href="/filesPage/<%= folderInfo.parentId%>">
                    <img src="/icons/backArrow.png" alt="">
                </a>
            <%} %>
            <h3><%= folderInfo.name%></h3>
            <a href="/filesPage/newFolder/<%= folderId %>" class="newFolderButton">
                <img src="/icons/newFolder.png">
            </a>
        </div>
        <% if (folders) {%>
            <ul>
                <%folders.map((folder) => {%>
                    <li>
                        <div class="folderRow">
                            <img src="/icons/folderIcon.png" alt="">
                            <a href="/filesPage/<%= folder.id %>"><%=folder.name %></a>
                        </div>
                    </li>    
                <%}) %>
            </ul>
        <%} %>
        <% if (files) {%>
            <ul>
                <%files.map((file) => {%>
                    <li>
                        <div class="folderRow">
                            <img src="/icons/fileIcon.png" alt="">
                            <%=file.filename %>
                            <a href="/filesPage/download/<%= file.id%>">
                                <img src="/icons/download.png" alt="">
                            </a>
                        </div>
                    </li>    
                <%}) %>
            </ul>
        <%} %>
        <% if (
            (!folders || folders.length ===0) && 
            (!files || files.length ===0)
            ) {%> 
            <p>No contents</p>
        <%}
        
        %>
    </div>
</body>
</html>